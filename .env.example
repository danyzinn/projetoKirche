# Copie para .env.local. Sem estas variáveis o app roda em MODO DEMONSTRAÇÃO
# (dados fictícios em memória, nada é persistido).
VITE_SUPABASE_URL=
# Chave pública "anon" — NUNCA coloque a service_role key no frontend.
VITE_SUPABASE_ANON_KEY=
# Slug da organização padrão quando o usuário pertence a mais de uma (opcional)
VITE_DEFAULT_ORG_SLUG=
